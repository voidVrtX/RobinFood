rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn() && profile().status == 'activo';
    }

    function isAdmin() {
      return activeUser()
        && request.auth.token.role == 'admin'
        && profile().role == 'admin';
    }

    function canReadReservation(reservationId) {
      let reservationPath = /databases/$(database)/documents/reservations/$(reservationId);
      return exists(reservationPath)
        && (get(reservationPath).data.receptorId == request.auth.uid
          || get(reservationPath).data.donorId == request.auth.uid);
    }

    match /users/{userId} {
      allow get: if activeUser() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if false;
      allow update: if activeUser() && (
        (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name','phone','address','lat','lng','prefs','acceptedTermsVersion','acceptedTermsAt','mustChangePassword','updatedAt','organization','businessName']))
        || isAdmin()
      );
      allow delete: if false;
    }

    match /donations/{donationId} {
      allow get, list: if activeUser()
        && (isAdmin()
          || resource.data.donorId == request.auth.uid
          || resource.data.status == 'disponible'
          || (resource.data.reservationId is string && canReadReservation(resource.data.reservationId)));
      allow create: if activeUser()
        && request.auth.token.role == 'donador'
        && profile().role == 'donador'
        && request.resource.data.donorId == request.auth.uid
        && request.resource.data.status == 'disponible';
      allow update: if activeUser()
        && (isAdmin()
          || (request.auth.token.role == 'donador' && resource.data.donorId == request.auth.uid));
      allow delete: if isAdmin()
        || (activeUser() && request.auth.token.role == 'donador' && resource.data.donorId == request.auth.uid);
    }

    match /reservations/{reservationId} {
      allow get, list: if activeUser()
        && (isAdmin()
          || resource.data.receptorId == request.auth.uid
          || resource.data.donorId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /reservationSecrets/{reservationId} {
      allow get: if activeUser() && resource.data.receptorId == request.auth.uid;
      allow list, create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow get, list: if activeUser()
        && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /messages/{messageId} {
      allow get, list: if activeUser()
        && (isAdmin()
          || resource.data.conversationId == request.auth.uid
          || resource.data.fromUserId == request.auth.uid
          || resource.data.toUserId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /accessRequests/{requestId} {
      allow get, list: if isAdmin();
      allow create: if request.resource.data.status == 'pendiente'
        && request.resource.data.name is string
        && request.resource.data.email is string;
      allow update, delete: if isAdmin();
    }

    match /auditLog/{entryId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /reports/{reportId} {
      allow get, list: if activeUser();
      allow create, update, delete: if false;
    }

    match /locations/{locationId} {
      allow get, list: if activeUser();
      allow create, update, delete: if false;
    }

    match /rateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
